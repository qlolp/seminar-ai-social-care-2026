pageType: content
background:
  type: solid
  color: $bg
elements:
- elementId: kicker
  elementType: text
  bounds: [60, 34, 700, 16]
  content:
    style: $kicker
    text: НАПРАВЛЕНИЕ Д · АНАТОМИЯ ЗАНЯТИЯ
- elementId: title
  elementType: text
  bounds: [60, 56, 840, 40]
  content:
    style: $h1
    text: 'Сорок минут тренажёра: из них тридцать — живые'
- elementId: line
  elementType: shape
  bounds: [60, 108, 840, 1]
  shapeName: rect
  fill:
    type: solid
    color: $line
- elementId: chart
  elementType: chart
  bounds: [60, 126, 520, 330]
  fontFamily: Noto Sans
  data:
    cols: ["Часть", "Минуты"]
    rows:
    - ["Живой разбор с тренером", 20]
    - ["Диалог с моделью", 12]
    - ["Правила и подводка", 8]
  series:
    - type: pie
      encode: {category: "Часть", value: "Минуты"}
      innerRadius: 0.58
      fill: ["$accent", "#B85C3D", "#E5E2D8"]
      dataLabels: {show: true, content: "value"}
  legend: {position: bottom, color: "#6E6A5E"}

- elementId: side
  elementType: text
  bounds: [620, 150, 280, 240]
  content:
    fontSize: 14
    lineHeight: 1.55
    color: $text
    fontFamily: Noto Sans
    text: '<p>Тридцать минут из сорока — <strong>живые</strong>: разбор с тренером и отыгрыш ситуации.</p><p>Модель — спарринг-партнёр, а не экзаменатор: сценарии пишутся из кейсов вашего учреждения.</p>'

- elementId: src
  elementType: text
  bounds: [60, 508, 760, 24]
  content:
    style: $small
    text: Устройство занятия — раздел 14 доклада
- elementId: pg
  elementType: text
  bounds: [900, 508, 40, 20]
  content:
    align: [right, top]
    style: $small
    text: '30'
