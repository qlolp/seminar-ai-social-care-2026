pageType: content
background:
  type: solid
  color: $bg
elements:
- elementId: kicker
  elementType: text
  bounds: [60, 34, 700, 16]
  content:
    style: $kicker
    text: ВОЗВРАТ ВРЕМЕНИ
- elementId: title
  elementType: text
  bounds: [60, 56, 840, 40]
  content:
    style: $h1
    text: 'Один промпт — и часы возвращаются к жителям'
- elementId: line
  elementType: shape
  bounds: [60, 108, 840, 1]
  shapeName: rect
  fill:
    type: solid
    color: $line
- elementId: chart
  elementType: chart
  bounds: [60, 126, 840, 330]
  fontFamily: Noto Sans
  data:
    cols: ["Процесс", "До", "После"]
    rows:
    - ["Сводка смены", 28, 10]
    - ["Ответ на обращение", 50, 18]
    - ["Сводка месяца", 240, 60]
  series:
    - type: bar
      encode: {x: "Процесс", y: "До"}
      name: "До, минут"
      fill: "#A8A294"
      dataLabels: {show: true, color: "#4A463C"}
    - type: bar
      encode: {x: "Процесс", y: "После"}
      name: "После, минут (с проверкой человеком)"
      fill: "$accent"
      dataLabels: {show: true, color: "#FFFFFF"}
  legend: {position: bottom, color: "#6E6A5E"}
  yAxis: {title: "минуты", label: {color: "#8A8578"}, gridLine: {color: "#E5E2D8"}}
  xAxis: {label: {color: "#4A463C"}, axisLine: {color: "#D6D1C4"}, gridLine: false}
  categoryGap: 0.45

- elementId: note
  elementType: text
  bounds: [60, 462, 840, 40]
  content:
    fontSize: 12.5
    lineHeight: 1.45
    color: $text
    fontFamily: Noto Sans
    text: 'Замер одного учреждения за квартал: это не «экономия минут», а сводка, которая стала содержательной и сравнимой по неделям.'

- elementId: src
  elementType: text
  bounds: [60, 508, 760, 24]
  content:
    style: $small
    text: Замеры учреждения на 300 мест, разделы 9 и 12 доклада
- elementId: pg
  elementType: text
  bounds: [900, 508, 40, 20]
  content:
    align: [right, top]
    style: $small
    text: '5'
