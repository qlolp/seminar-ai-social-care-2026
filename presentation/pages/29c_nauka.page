pageType: content
background:
  type: solid
  color: $bg
elements:
- elementId: kicker
  elementType: text
  bounds: [60, 34, 700, 16]
  content:
    style: $kicker
    text: НАУКА 2024–2026
- elementId: title
  elementType: text
  bounds: [60, 56, 840, 40]
  content:
    style: $h1
    text: 'Что подтвердилось в рецензируемой литературе'
- elementId: line
  elementType: shape
  bounds: [60, 108, 840, 1]
  shapeName: rect
  fill:
    type: solid
    color: $line
- elementId: i1
  elementType: text
  bounds: [60, 128, 405, 118]
  content:
    fontSize: 13
    lineHeight: 1.5
    color: $text
    fontFamily: Noto Sans
    text: '<p><strong>Падения.</strong> Ложные тревоги — обычная беда, не сбой одной камеры. Обзор 2025 года показывает разброс качества. Поэтому порог: не больше двух ложных тревог в неделю на камеру.</p>'
- elementId: i2
  elementType: text
  bounds: [495, 128, 405, 118]
  content:
    fontSize: 13
    lineHeight: 1.5
    color: $text
    fontFamily: Noto Sans
    text: '<p><strong>Документы.</strong> Программы, которые пишут черновик записи, уже входят в практику. Человек всё равно проверяет. Как в нашем регламенте.</p>'
- elementId: i3
  elementType: text
  bounds: [60, 256, 405, 118]
  content:
    fontSize: 13
    lineHeight: 1.5
    color: $text
    fontFamily: Noto Sans
    text: '<p><strong>Выдумки модели.</strong> Свежая работа 2025 года — самая цитируемая по этой теме. Подтверждает наше правило: подпись человека и паспорт пилота.</p>'
- elementId: i4
  elementType: text
  bounds: [495, 256, 405, 118]
  content:
    fontSize: 13
    lineHeight: 1.5
    color: $text
    fontFamily: Noto Sans
    text: '<p><strong>Дома ухода — отдельная полка.</strong> Обзоры 2024–2025 годов говорят одно: мешает не техника, а регламент и обучение.</p>'
- elementId: note
  elementType: text
  bounds: [60, 386, 840, 72]
  content:
    fontSize: 12.5
    lineHeight: 1.45
    color: $text
    fontFamily: Noto Sans
    text: 'Четыре вывода совпадают с докладом. Машина готовит — человек решает. Один удачный дом ещё не вся сеть.'
- elementId: src
  elementType: text
  bounds: [60, 508, 760, 24]
  content:
    style: $small
    text: 'Gorce 2025; Mess 2025; Kim 2025; Ronan 2025; Wong 2024 — список в докладе'
- elementId: pg
  elementType: text
  bounds: [900, 508, 40, 20]
  content:
    align: [right, top]
    style: $small
    text: '43'
