version: v2
title: Искусственный интеллект в домах социального обслуживания — презентация семинара
size:
- 960
- 540
theme:
  colors:
    primary: '#2F5D50'
    accent: '#B57517'
    text: '#20242A'
    muted: '#6B7280'
    bg: '#FAF8F4'
    soft: '#E7E1D6'
    softgreen: '#DCE6E0'
    line: '#C9C2B4'
    dark: '#1F3D33'
  textStyles:
    kicker:
      fontSize: 11
      color: $primary
      fontFamily: MiSans
      letterSpacing: 2
      bold: true
    h1:
      fontSize: 27
      bold: true
      color: $text
      fontFamily: MiSans
      lineHeight: 1.15
    body:
      fontSize: 14.5
      color: $text
      fontFamily: MiSans
      lineHeight: 1.45
    small:
      fontSize: 10.5
      color: $muted
      fontFamily: MiSans
      lineHeight: 1.3
